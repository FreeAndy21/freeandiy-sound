<?xml version="1.0" encoding="utf-8"?>
<!--
  FreeANDIY Sound MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build soundcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.scraft` sessions owned by
  FreeANDIY Sound, and FreeANDIY Sound offered under "Open with" for WAV/AIFF/FLAC/MP3 and MIDI files
  (without taking over the user's default player for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="FreeANDIY Sound"
      Manufacturer="Free Andy Agency"
      Version="$(var.Version)"
      UpgradeCode="14A0E25F-DEA0-4D67-8D7E-D51713506FF0"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="FreeANDIY Sound digital audio workstation" Manufacturer="Free Andy Agency" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of FreeANDIY Sound is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="SoundcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SoundcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://freeandiy.freeandy.agency/sound" />
    <Property Id="ARPURLUPDATEINFO" Value="https://freeandiy.freeandy.agency/sound" />
    <Property Id="ARPHELPLINK" Value="https://github.com/FreeAndy21/freeandiy-sound/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="FreeANDIY Sound" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="FreeANDIY Sound" Level="1">
      <ComponentGroupRef Id="SoundcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="SoundcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="SoundcraftApp" Guid="3BD4BD8F-57A4-4E9C-ABFA-A565BF50C308">
        <File Id="SoundcraftExe" Source="$(var.BinDir)\freeandiy-sound.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="FreeANDIY Sound"
              Description="FreeANDIY Sound digital audio workstation" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="SoundcraftIcon.ico" IconIndex="0" />
        </File>

        <!-- .scraft: FreeANDIY Sound's own session format; FreeANDIY Sound is its default app. -->
        <ProgId Id="FreeANDIY Sound.Session" Description="FreeANDIY Sound Session" Icon="SoundcraftExe" IconIndex="0">
          <Extension Id="scraft" ContentType="application/x-freeandiy-sound-session">
            <Verb Id="open" Command="Open" TargetFile="SoundcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Audio and MIDI files: offered under "Open with" (imported into a session), never forced
             as the default. -->
        <ProgId Id="FreeANDIY Sound.Audio" Description="Audio File" Icon="SoundcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Sound.Audio\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="FreeANDIY Sound.Midi" Description="MIDI File" Icon="SoundcraftExe" IconIndex="0" />
        <RegistryValue Root="HKLM" Key="Software\Classes\FreeANDIY Sound.Midi\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.wav\OpenWithProgids" Name="FreeANDIY Sound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aif\OpenWithProgids" Name="FreeANDIY Sound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.aiff\OpenWithProgids" Name="FreeANDIY Sound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.flac\OpenWithProgids" Name="FreeANDIY Sound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mp3\OpenWithProgids" Name="FreeANDIY Sound.Audio" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.mid\OpenWithProgids" Name="FreeANDIY Sound.Midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.midi\OpenWithProgids" Name="FreeANDIY Sound.Midi" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "freeandiy-sound"). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe" Name="FriendlyAppName" Value="FreeANDIY Sound" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\shell\open\command" Value="&quot;[#SoundcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".scraft" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".wav" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".aif" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".aiff" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".flac" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".mp3" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".mid" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\freeandiy-sound.exe\SupportedTypes" Name=".midi" Value="" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\freeandiy-sound.exe" Value="[#SoundcraftExe]" Type="string" />
      </Component>

      <Component Id="SoundcraftCli" Guid="6EC5B698-5662-4A39-AEF3-C57BB6B02360">
        <File Id="SoundcraftCliExe" Source="$(var.BinDir)\freeandiy-sound-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
