<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info definition for FreeANDIY Sound's session format. Audio and MIDI types come from
     the system database. Installed to /usr/share/mime/packages/ (update-mime-database runs on
     install). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-freeandiy-sound-session">
    <comment>FreeANDIY Sound session</comment>
    <sub-class-of type="application/json"/>
    <icon name="agency.freeandy.sound"/>
    <glob pattern="*.scraft"/>
  </mime-type>
</mime-info>
